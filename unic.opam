opam-version: "2.0"
name:         "unic"
maintainer:   "Romain Calascibetta <romain.calascibetta@gmail.com>"
authors:      "Romain Calascibetta <romain.calascibetta@gmail.com>"
homepage:     "https://git.robur.coop/robur/uniq"
bug-reports:  "https://git.robur.coop/robur/uniq/issues"
dev-repo:     "git+https://git.robur.coop/robur/uniq.git"
license:      "AGPL-3.0-or-later"
build: [
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
depends: [
  "ocaml"       {>= "4.07.0"}
  "dune"        {>= "2.8.0"}
  "uniq"        {= version}
  "re"
  "bos"
  "fpath"
  "fmt"
  "logs"
  "cmdliner"
  "ocamlfind"
  "bstr"        {with-test}
  "checkseum"   {with-test}
  "decompress"  {with-test}
  "digestif"    {with-test}
]
